  "step_groups": [
    {
      "label": null,
      "steps": [
        {
          "number": 1,
          "instruction": "Combine cornstarch, evaporated milk, mustard, and hot sauce. Whisk until homogeneous. Set aside.",
          "duration_minutes": null,
          "temperature": null
        },
        {
          "number": 2,
          "instruction": "Whisk together milk, half the parsley, mushrooms, onion powder, garlic powder, and MSG. Set aside.",
          "duration_minutes": null,
          "temperature": null
        },
        {
          "number": 3,
          "instruction": "Bring a pot of salted water, barely enough to completely cover the macaroni, to a boil, and add macaroni. Cook until about 2 minutes shy of al dente, reserving pasta water.",
          "duration_minutes": null,
          "temperature": null
        },
        {
          "number": 4,
          "instruction": "In the meantime, in a large skillet, heat oil over medium-high heat until shimmering. Add mince, and sear without moving or stirring until a crust forms; about 1-2 minutes. Break up with a wooden spoon and season lightly with salt and pepper. Cook until no pink remains visible; about 5 minutes.",
          "duration_minutes": 5,
          "temperature": null
        },
        {
          "number": 5,
          "instruction": "Add onions, cook until semi-translucent; about 2 minutes. Add garlic, cooking until fragrant; around 30 seconds.",
          "duration_minutes": 2,
          "temperature": null
        },
        {
          "number": 6,
          "instruction": "Add milk and spice mixture to mince. Stir until well incorporated, and scrape up any browned bits on the bottom of the pan. Reduce heat to barely above a simmer.",
          "duration_minutes": null,
          "temperature": null
        },
        {
          "number": 7,
          "instruction": "When the pasta is cooked, add to the pan with the mince along with 150 ml of reserved pasta water and stir through. Let simmer for 1-2 minutes, until pasta is perfectly al dente. Remove from heat.",
          "duration_minutes": 2,
          "temperature": null
        },
        {
          "number": 8,
          "instruction": "Add evaporated milk mixture and grated cheese to skillet and stir through, letting the residual heat melt the cheese and emulsify into a thick sauce. If the sauce is too thick, thin out with a splash of milk or pasta water on low heat, below a simmer, stirring constantly to combine.",
          "duration_minutes": null,
          "temperature": null
        },
        {
          "number": 9,
          "instruction": "Garnish with the rest of the parsley and serve immediately.",
          "duration_minutes": null,
          "temperature": null
        }
      ]
    }
  ],
